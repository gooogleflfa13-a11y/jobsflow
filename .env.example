# Google Sheets API
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GSHEET_ID=your-google-sheet-id

# CTgoodjobs CLI (optional - if not set, homepage bootstrap is used)
# CTGOOD_SID=
# CTGOOD_VISITOR_ID=
# CTGOOD_CHANNEL_ID=1

# Candidate name (used in tailor.py summary generation)
CANDIDATE_NAME=Your Name

# Portal JD browser (optional)
# PORTAL_JD_BROWSER=1
# PORTAL_JD_CHANNEL=chrome
# PORTAL_JD_STORAGE_STATE=/path/to/storage_state.json
